# Copy to .env on any machine:  cp .env.example .env
# These are DEV defaults. Safe to commit this file; never commit .env.

POSTGRES_PASSWORD=devpassword
JWT_SECRET=dev-secret-change-me

# Host port for Postgres. 5433 by default so it won't collide with a
# Postgres you may already have running locally on 5432.
POSTGRES_PORT=5433
API_PORT=8080

MAX_SEATS_PER_USER=4
DB_POOL_MAX=20
QUERY_TIMEOUT=2s

# 1 exposes POST /dev/token so burst.sh can mint JWTs. Dev only.
ENABLE_DEV_TOKEN=1

# 1 swaps the atomic locking statement for the naive read-then-write,
# to demonstrate the double-sell it prevents. Never 1 in production.
UNSAFE_MODE=0
